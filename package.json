{
  "name": "harvee-technologies-assessment",
  "version": "1.0.0",
  "description": "SauceDemo Playwright + TypeScript automation framework (regression and E2E)",
  "scripts": {
    "test": "node scripts/run-with-report.mjs",
    "test:chromium": "node scripts/run-with-report.mjs --project=chromium",
    "test:firefox": "node scripts/run-with-report.mjs --project=firefox",
    "test:webkit": "node scripts/run-with-report.mjs --project=webkit",
    "test:edge": "node scripts/run-with-report.mjs --project=edge",
    "test:chrome": "node scripts/run-with-report.mjs --project=chrome",
    "test:obscura": "node scripts/run-with-report.mjs --project=obscura",
    "test:obscura:smoke": "node scripts/run-with-report.mjs --project=obscura --grep @smoke",
    "test:obscura:sanity": "node scripts/run-with-report.mjs --project=obscura --grep @sanity",
    "test:obscura:regression": "node scripts/run-with-report.mjs --project=obscura --grep @regression",
    "test:obscura:e2e": "node scripts/run-with-report.mjs --project=obscura --grep @e2e",
    "test:obscura:login": "node scripts/run-with-report.mjs tests/login.spec.ts --project=obscura",
    "test:obscura:session-security": "node scripts/run-with-report.mjs tests/session-security.spec.ts --project=obscura",
    "test:session-security": "node scripts/run-with-report.mjs tests/session-security.spec.ts --project=chromium",
    "test:list": "playwright test --list",
    "test:list:chromium": "playwright test --list --project=chromium",
    "test:list:obscura": "playwright test --list --project=obscura",
    "test:list:session-security": "playwright test --list tests/session-security.spec.ts --project=chromium",
    "test:smoke": "node scripts/run-with-report.mjs --grep @smoke",
    "test:sanity": "node scripts/run-with-report.mjs --grep @sanity",
    "test:regression": "node scripts/run-with-report.mjs --grep @regression",
    "test:e2e": "node scripts/run-with-report.mjs --grep @e2e",
    "typecheck": "tsc --noEmit",
    "report": "node scripts/show-report.mjs",
    "report:generate": "node scripts/report/generate-report.mjs",
    "report:synthetic": "node scripts/report/generate-synthetic.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  },
  "keywords": [
    "playwright",
    "typescript",
    "saucedemo",
    "e2e",
    "regression"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
