# SauceDemo Playwright environment configuration
# Copy to `.env` (or let the framework create `.env` with defaults) and adjust as needed.
# `.env` is gitignored — never commit real secrets.

# Application base URL used by Playwright (`use.baseURL`)
# Default when missing or blank: https://www.saucedemo.com
BASE_URL=https://www.saucedemo.com

# Public SauceDemo demo accounts (shown on the login page — not application secrets)
# Defaults when missing or blank: standard_user / locked_out_user / secret_sauce
STANDARD_USER=standard_user
LOCKED_USER=locked_out_user
USER_PASSWORD=secret_sauce

# Optional Obscura CDP backend (opt-in via `npm run test:obscura*` only — not used by default headless)
# Start local Obscura first: obscura serve --port 9222
# Default when missing or blank: ws://127.0.0.1:9222
OBSCURA_CDP_URL=ws://127.0.0.1:9222
# Bearer token for non-loopback Obscura binds (leave blank for local loopback)
OBSCURA_CDP_TOKEN=
